; DARK EVIDENCE — HỒ SƠ BÓNG TỐI. Open this file in Godot 4.6.3.
config_version=5

[application]
config/name="DARK EVIDENCE — Hồ Sơ Bóng Tối"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]
Settings="*res://scripts/core/settings.gd"
GameState="*res://scripts/core/game_state.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.04, 1)
renderer/textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/physics_ticks_per_second=60

[gui]
theme/default_font_multichannel_signed_distance_field=true

[audio]
driver/enable_input=false
