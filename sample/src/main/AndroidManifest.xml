<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="vn.apktachgoc.sample.permission.PRIVATE" android:protectionLevel="signature"/>
    <uses-permission android:name="vn.apktachgoc.sample.permission.PRIVATE"/>
    <application android:label="@string/app_name" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:taskAffinity="vn.apktachgoc.sample" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <provider android:name=".NotesProvider" android:authorities="vn.apktachgoc.sample.notes;fixed.sample.authority" android:exported="false"/>
        <receiver android:name=".SessionReceiver" android:exported="true"><intent-filter><action android:name="vn.apktachgoc.sample.SET_MARKER"/></intent-filter></receiver>
    </application>
</manifest>
